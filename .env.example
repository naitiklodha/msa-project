# ──────────────────── FocusPulse Environment ────────────────────
# Copy this file to .env and fill in values

# ── Global ──
NODE_ENV=development

# ── PostgreSQL ──
POSTGRES_USER=focuspulse
POSTGRES_PASSWORD=changeme_pg
POSTGRES_DB=focuspulse
PG_CONNECTION_STRING=postgresql://focuspulse:changeme_pg@postgres:5432/focuspulse?sslmode=disable

# ── Redis ──
REDIS_URL=redis://redis:6379

# ── Kafka ──
KAFKA_BROKERS=kafka:9092

# ── Auth / JWT ──
JWT_SECRET=changeme_jwt_secret_min_32_chars!!
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── Service Ports ──
AUTH_SERVICE_PORT=3001
GAME_SERVICE_PORT=3002
TIMER_SERVICE_PORT=3004
LEADERBOARD_SERVICE_PORT=3005
NOTIFICATION_SERVICE_PORT=3007
ROOM_SERVICE_PORT=3008
BFF_PORT=3010
RAG_SERVICE_PORT=8080
ANALYTICS_SERVICE_PORT=4000

# ── Gemini / RAG ──
POSTGRES_URL=postgresql://focuspulse:changeme_pg@postgres:5432/focuspulse?sslmode=disable
GOOGLE_API_KEY=replace_with_google_api_key
GEMINI_LLM_MODEL=models/gemini-3.0-flash
EMBEDDING_DIM=768

# ── Kong ──
KONG_DATABASE=off
KONG_DECLARATIVE_CONFIG=/etc/kong/kong.yml
KONG_PROXY_LISTEN=0.0.0.0:8000
KONG_ADMIN_LISTEN=0.0.0.0:8001

# ── Browser and CORS ──
VITE_API_BASE_URL=
VITE_WS_BASE_URL=
CORS_ORIGINS=["http://localhost:8000","http://localhost:8002","http://localhost:5173"]
KONG_CORS_ORIGIN=http://localhost:8002

# ── Internal Service URLs ──
AUTH_SERVICE_URL=http://auth-service:3001
GAME_SERVICE_URL=http://game-service:3002
TIMER_SERVICE_URL=http://timer-service:3004
RAG_SERVICE_URL=http://rag-service:8080
BFF_SERVICE_URL=http://bff:3010
LEADERBOARD_SERVICE_URL=http://leaderboard-service:3005
NOTIFICATION_SERVICE_URL=http://notification-service:3007
ROOM_SERVICE_URL=http://room-service:3008
ANALYTICS_SERVICE_URL=http://analytics-service:4000
QUIZ_SERVICE_URL=http://rag-service:8080/documents/quiz
FRONTEND_SERVICE_URL=http://frontend:80
KONG_UPSTREAM_URL=http://kong:8000

# ── Observability ──
JAEGER_ENDPOINT=http://jaeger:14268/api/traces
