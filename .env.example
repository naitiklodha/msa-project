# ──────────────────── FocusPulse Environment ────────────────────
# Copy this file to .env and fill in values

# ── Global ──
NODE_ENV=development

# ── PostgreSQL ──
POSTGRES_USER=focuspulse
POSTGRES_PASSWORD=changeme_pg
POSTGRES_DB=focuspulse
PG_CONNECTION_STRING=postgresql://focuspulse:changeme_pg@postgres:5432/focuspulse

# ── Redis ──
REDIS_URL=redis://redis:6379

# ── Kafka ──
KAFKA_BROKERS=kafka:9092

# ── Auth / JWT ──
JWT_SECRET=changeme_jwt_secret_min_32_chars!!
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── Service Ports ──
AUTH_SERVICE_PORT=3001
GAME_SERVICE_PORT=3002
QUIZ_SERVICE_PORT=3003
TIMER_SERVICE_PORT=3004
BFF_PORT=3010
LEADERBOARD_PORT=3020
ANALYTICS_PORT=3021
DLQ_PROCESSOR_PORT=3022
SAGA_ORCHESTRATOR_PORT=3023

# ── Kong ──
KONG_DATABASE=off
KONG_DECLARATIVE_CONFIG=/etc/kong/kong.yml
KONG_PROXY_LISTEN=0.0.0.0:8000
KONG_ADMIN_LISTEN=0.0.0.0:8001

# ── Observability ──
JAEGER_ENDPOINT=http://jaeger:14268/api/traces
